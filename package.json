{
  "name": "pa-safra-compensacao-ambiental-social",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "images:prepare": "node tools/prepare-requester-images.mjs",
    "dev": "npm run images:prepare && vite --host 127.0.0.1 --port 4286 --strictPort",
    "build": "npm run images:prepare && node tools/prepublish.mjs && vite build && node tools/layout-build-check.mjs && node tools/title-style-build-check.mjs && node tools/page-header-build-check.mjs",
    "check": "npm run images:prepare && node tools/check.mjs",
    "editorial:audit": "node tools/editorial-blockers-audit.mjs",
    "admin:test": "node tools/admin-contract.mjs && node tools/layout-assist-test.mjs && node tools/title-style-assist-test.mjs && node tools/title-first-paint-test.mjs && node tools/page-header-assist-test.mjs",
    "admin:auth-test": "node tools/admin-auth-test.mjs",
    "admin:content-guard-test": "node tools/admin-content-guard-test.mjs",
    "admin:ui-test": "node tools/admin-ui-browser-test.mjs",
    "admin:credentials": "node tools/admin-credentials.mjs",
    "cloudflare:test": "node tools/cloudflare-readiness.mjs",
    "cloudflare:env-test": "node tools/cloudflare-env-contract.mjs",
    "prepublish:check": "node tools/prepublish.mjs --strict",
    "smoke": "node tools/smoke-build.mjs",
    "smoke:remote": "node tools/smoke-remote.mjs",
    "preview": "npm run images:prepare && vite preview --host 127.0.0.1 --port 4286 --strictPort"
  },
  "devDependencies": {
    "vite": "^7.0.0"
  }
}
